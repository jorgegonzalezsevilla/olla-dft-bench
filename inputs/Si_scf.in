&CONTROL
  calculation = 'scf', prefix = 'Si', outdir = './out', pseudo_dir = './pp'   ! generated with QE 7.4 (conda-forge); Si_scf.out and Si_scf.xml are its outputs
/
&SYSTEM
  ibrav = 2, celldm(1) = 10.26, nat = 2, ntyp = 1
  ecutwfc = 30, ecutrho = 240, nbnd = 8, occupations = 'fixed'
/
&ELECTRONS
  conv_thr = 1e-10
/
ATOMIC_SPECIES
  Si  28.0855  Si.pbe-n-rrkjus_psl.1.0.0.UPF
ATOMIC_POSITIONS crystal
  Si 0.00 0.00 0.00
  Si 0.25 0.25 0.25
K_POINTS automatic
  8 8 8 0 0 0
