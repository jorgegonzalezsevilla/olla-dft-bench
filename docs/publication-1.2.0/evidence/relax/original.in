&CONTROL
 calculation = 'relax',
 prefix = 'silicon',
 tprnfor = .true.,
 tstress = .true.,

  pseudo_dir = './pp',
/
&SYSTEM
 ibrav = 2, celldm(1) = 10.2,
 nat = 2, ntyp = 1,
 ecutwfc = 18.0,
/
&ELECTRONS
 conv_thr = 1.0d-9,
/
&IONS
 ion_dynamics = 'bfgs'
/
ATOMIC_SPECIES
 Si 28.0855 Si.pz-vbc.UPF
ATOMIC_POSITIONS alat
 Si 0.00 0.00 0.00
 Si 0.26 0.25 0.25
K_POINTS automatic
 4 4 4 0 0 0
